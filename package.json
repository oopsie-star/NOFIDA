{
  "name": "nofida",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "build:github": "tsc -b && vite build --mode github",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "infra:up": "docker-compose up -d",
    "infra:down": "docker-compose down",
    "dev:platform": "docker-compose up -d && npm run dev"
  },
  "dependencies": {
    "lucide-react": "1.17.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "zustand": "5.0.13"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "tailwindcss": "4.3.0",
    "typescript": "6.0.3",
    "vite": "8.0.14"
  }
}
